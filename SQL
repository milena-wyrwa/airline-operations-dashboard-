-- Data type conversion and column extension
-- Adding structured numeric columns for analysis

ALTER TABLE stg_airline_delays
ADD year_int INT,
    month_int INT,

    arr_flights_f FLOAT,
    arr_del15_f FLOAT,

    carrier_ct_f FLOAT,
    weather_ct_f FLOAT,
    nas_ct_f FLOAT,
    security_ct_f FLOAT,
    late_aircraft_ct_f FLOAT,

    arr_cancelled_f FLOAT,
    arr_diverted_f FLOAT,

    arr_delay_f FLOAT,
    carrier_delay_f FLOAT,
    weather_delay_f FLOAT,
    nas_delay_f FLOAT,
    security_delay_f FLOAT,
    late_aircraft_delay_f FLOAT;


-- Data type transformation from raw text fields to numeric format
-- Using TRY_CAST to handle invalid values safely

UPDATE dbo.Airline_Delay_Cause_RAW
SET
    year_int = TRY_CAST(year AS INT),
    month_int = TRY_CAST(month AS INT),

    arr_flights_f = TRY_CAST(arr_flights AS FLOAT),
    arr_del15_f = TRY_CAST(arr_del15 AS FLOAT),

    carrier_ct_f = TRY_CAST(carrier_ct AS FLOAT),
    weather_ct_f = TRY_CAST(weather_ct AS FLOAT),
    nas_ct_f = TRY_CAST(nas_ct AS FLOAT),
    security_ct_f = TRY_CAST(security_ct AS FLOAT),
    late_aircraft_ct_f = TRY_CAST(late_aircraft_ct AS FLOAT),

    arr_cancelled_f = TRY_CAST(arr_cancelled AS FLOAT),
    arr_diverted_f = TRY_CAST(arr_diverted AS FLOAT),

    arr_delay_f = TRY_CAST(arr_delay AS FLOAT),

    carrier_delay_f = TRY_CAST(carrier_delay AS FLOAT),
    weather_delay_f = TRY_CAST(weather_delay AS FLOAT),
    nas_delay_f = TRY_CAST(nas_delay AS FLOAT),
    security_delay_f = TRY_CAST(security_delay AS FLOAT),
    late_aircraft_delay_f = TRY_CAST(late_aircraft_delay AS FLOAT);


